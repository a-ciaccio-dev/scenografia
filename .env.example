# Local OpenRouter configuration
# Required for live generation commands only. Never commit a real key.
OPENROUTER_API_KEY=replace-with-your-local-openrouter-key

# Optional. Keep the default unless you intentionally target a different endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional per-mode model mappings.
# Keep exact provider model IDs configurable here instead of hardcoding them.
# Example placeholders only:
OPENROUTER_DRAFT_MODEL=provider/model-for-draft
OPENROUTER_STANDARD_MODEL=provider/model-for-standard
OPENROUTER_PRODUCTION_MODEL=provider/model-for-production
OPENROUTER_VECTOR_READY_MODEL=provider/model-for-vector-ready

# Input and output directories.
APP_INPUT_DIR=input
APP_OUTPUT_DIR=output

# Optional debug logging.
APP_DEBUG=false
