# OpenRouter API Configuration (for image generation)
# Get your free API key from https://openrouter.ai/keys
# Required for live generation commands only. Never commit a real key.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Optional. API endpoint for OpenRouter (image generation via chat/completions).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional per-mode model mappings (OpenRouter model IDs).
# Important: Models must support output_modalities=image
# Keep exact model IDs configurable here instead of hardcoding them.
# 
# Recommended starting point:
#  - google/gemini-2.5-flash-image (good balance of quality and speed)
# 
# Find models with image output at https://openrouter.ai/models
# Make sure your account has access to the image output modality.
OPENROUTER_DRAFT_MODEL=google/gemini-2.5-flash-image
OPENROUTER_STANDARD_MODEL=google/gemini-2.5-flash-image
OPENROUTER_PRODUCTION_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VECTOR_READY_MODEL=google/gemini-2.5-flash-image

# Optional model for the AI Prompt Enhancer Agent (must support text output modality).
# Recommended starting point: google/gemini-2.5-flash or google/gemini-3.1-flash
OPENROUTER_ENHANCER_MODEL=google/gemini-2.5-flash

# Input and output directories.
APP_INPUT_DIR=input
APP_OUTPUT_DIR=output

# Optional debug logging.
APP_DEBUG=false
